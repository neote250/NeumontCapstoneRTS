+## is the player → team lookup the match fills once at startup.
 
+
+#region ────────────────────────────  constants  ─────────────────────────────
+
+## player_id of the NeutralController, and so of every wild squad.
 const NEUTRAL: int = -1
+## team_id of a controller on no team. Only the NeutralController.
